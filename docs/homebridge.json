{
  "accessories": [
    {
      "url": "mqtt://IP_DEL_BROKER:1883",
      "username": "USUARIO_MQTT",
      "password": "CONTRASENA_MQTT",
      "accessory": "mqttthing",
      "type": "airQualitySensor",
      "name": "Calidad del aire Sensirion",
      "serviceNames": {
        "temperature": "Temperatura Sensirion",
        "humidity": "Humedad Sensirion"
      },
      "topics": {
        "getOnline": {
          "topic": "sen66-XXXXXX/status",
          "apply": "return String(message).trim()==='online';"
        },
        "getAirQuality": {
          "topic": "sen66-XXXXXX/state",
          "apply": "const m={good:'EXCELLENT',fair:'GOOD',moderate:'FAIR',poor:'INFERIOR',bad:'POOR',BUENO:'EXCELLENT',ACEPTABLE:'GOOD',REGULAR:'FAIR',MALO:'INFERIOR','MUY MALO':'POOR'};return m[JSON.parse(message).level]||state;"
        },
        "getPM2_5Density": {
          "topic": "sen66-XXXXXX/state",
          "apply": "const d=JSON.parse(message); return d.pm25==null?state:d.pm25;"
        },
        "getPM10Density": {
          "topic": "sen66-XXXXXX/state",
          "apply": "const d=JSON.parse(message); return d.pm10==null?state:d.pm10;"
        },
        "getCarbonDioxideLevel": {
          "topic": "sen66-XXXXXX/state",
          "apply": "const d=JSON.parse(message); return d.co2==null?state:d.co2;"
        },
        "getCurrentTemperature": {
          "topic": "sen66-XXXXXX/state",
          "apply": "const d=JSON.parse(message); return d.temperature==null?state:d.temperature;"
        },
        "getCurrentRelativeHumidity": {
          "topic": "sen66-XXXXXX/state",
          "apply": "const d=JSON.parse(message); return d.humidity==null?state:d.humidity;"
        }
      }
    },
    {
      "url": "mqtt://IP_DEL_BROKER:1883",
      "username": "USUARIO_MQTT",
      "password": "CONTRASENA_MQTT",
      "accessory": "mqttthing",
      "type": "carbonDioxideSensor",
      "name": "CO2 Sensirion",
      "topics": {
        "getOnline": {
          "topic": "sen66-XXXXXX/status",
          "apply": "return String(message).trim()==='online';"
        },
        "getCarbonDioxideDetected": {
          "topic": "sen66-XXXXXX/state",
          "apply": "const c=JSON.parse(message).co2; return c==null?state:(c>1200?'ABNORMAL':'NORMAL');"
        },
        "getCarbonDioxideLevel": {
          "topic": "sen66-XXXXXX/state",
          "apply": "const d=JSON.parse(message); return d.co2==null?state:d.co2;"
        }
      }
    }
